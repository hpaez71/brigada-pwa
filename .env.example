# Copie este archivo como .env.local y complete con los datos de su proyecto Firebase
# (Consola Firebase > Configuración del proyecto > Tus apps > App web)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=su-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=su-proyecto
VITE_FIREBASE_STORAGE_BUCKET=su-proyecto.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloud Messaging > Certificados push web (par de claves VAPID)
VITE_FIREBASE_VAPID_KEY=

# Región donde se despliegan las Cloud Functions
VITE_FUNCTIONS_REGION=us-central1

# Opcional: App Check con reCAPTCHA v3 (recomendado en producción)
VITE_RECAPTCHA_SITE_KEY=

# Respaldo sin Internet: teléfonos para llamada / SMS nativo del dispositivo
VITE_EMERGENCY_PHONE=123
VITE_COORDINATOR_PHONE=+573000000000

# Nombre de la organización (aparece en reportes PDF)
VITE_ORG_NAME=Mi Empresa S.A.S.

# Ruta base. En GitHub Pages: /<nombre-del-repositorio>/ (el workflow la define)
VITE_BASE=/

# true para usar Firebase Emulator Suite en desarrollo
VITE_USE_EMULATORS=false

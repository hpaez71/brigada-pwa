rules_version = '2';

// =====================================================================
//  Reglas de seguridad – Plataforma de Brigadas de Emergencia
//  El rol se toma SOLO de los custom claims del token (request.auth.token.role),
//  que únicamente pueden asignar las Cloud Functions (asignarRol / crearUsuario).
//  Jerarquía: admin(4) > coordinador(3) > jefe_brigada(2) > brigadista(1)
// =====================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function signedIn() { return request.auth != null; }
    function rank() {
      return {'admin': 4, 'coordinador': 3, 'jefe_brigada': 2, 'brigadista': 1}
        .get(request.auth.token.get('role', 'none'), 0);
    }
    function isMember() { return signedIn() && rank() >= 1; }
    function isJefe()   { return signedIn() && rank() >= 2; }
    function isCoord()  { return signedIn() && rank() >= 3; }
    function isAdmin()  { return signedIn() && rank() >= 4; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function onlyChanged(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }
    function validLatLng(p) {
      return p == null || (p.lat is number && p.lng is number
        && p.lat >= -90 && p.lat <= 90 && p.lng >= -180 && p.lng <= 180);
    }
    function emergenciaTipos() {
      return ['evacuacion_general', 'incendio', 'sismo', 'derrame_quimico', 'amenaza_seguridad', 'emergencia_medica', 'simulacro'];
    }
    function estadosRespuesta() {
      return ['recibido', 'en_desplazamiento', 'en_punto', 'zona_evacuada', 'controlado', 'necesito_apoyo'];
    }

    // ---------- Usuarios (perfil completo, contiene datos personales) ----------
    match /users/{uid} {
      allow read: if isOwner(uid) || isJefe();
      // La creación normal ocurre en la Cloud Function crearUsuario.
      allow create: if false;
      // Coordinadores editan perfiles, pero nunca rol/email/claims.
      allow update: if (isCoord()
                        && !request.resource.data.diff(resource.data).affectedKeys()
                              .hasAny(['role', 'email', 'claimsUpdatedAt', 'createdAt']))
                    || (isOwner(uid)
                        && onlyChanged(['telefono', 'fotoUrl', 'disponible', 'updatedAt']));
      allow delete: if false; // se desactiva (estado = inactivo) para preservar trazabilidad
    }

    // ---------- Directorio público interno (subconjunto sin datos sensibles) ----------
    match /directorio/{uid} {
      allow read: if isMember();
      allow write: if false; // lo mantiene la Cloud Function onUserWritten
    }

    // ---------- Tokens FCM ----------
    match /fcmTokens/{token} {
      allow read, delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow create, update: if isMember() && request.resource.data.uid == request.auth.uid;
    }

    // ---------- Centros de operación ----------
    match /sedes/{sedeId} {
      allow read: if isMember();
      allow create, update: if isCoord();
      allow delete: if isAdmin();
    }

    // ---------- Emergencias ----------
    match /emergencias/{emId} {
      allow read: if isMember();
      allow create: if isJefe()
        && request.resource.data.activadaPor.uid == request.auth.uid
        && request.resource.data.estado == 'activa'
        && request.resource.data.tipo in emergenciaTipos()
        && request.resource.data.nivel in ['bajo', 'medio', 'alto', 'critico']
        && request.resource.data.createdAt == request.time
        && request.resource.data.totalRespuestas == 0
        && validLatLng(request.resource.data.get('ubicacion', null));
      allow update: if isJefe()
        && resource.data.estado == 'activa'
        && onlyChanged(['estado', 'closedAt', 'cerradaPor', 'observacionesCierre', 'updatedAt', 'nivel', 'descripcion'])
        && request.resource.data.estado in ['activa', 'cerrada'];
      allow delete: if false; // evidencia para auditoría

      match /respuestas/{uid} {
        allow read: if isMember();
        // Campos calculados por el servidor que el cliente no puede alterar
        function serverFieldsIntact() {
          return (resource == null && !request.resource.data.keys().hasAny(['tiempoRespuestaSeg']))
            || (resource != null
                && request.resource.data.get('tiempoRespuestaSeg', null) == resource.data.get('tiempoRespuestaSeg', null));
        }
        allow create, update: if isOwner(uid) && isMember()
          && request.resource.data.uid == uid
          && request.resource.data.estado in estadosRespuesta()
          && validLatLng(request.resource.data.get('ubicacion', null))
          && serverFieldsIntact()
          && get(/databases/$(database)/documents/emergencias/$(emId)).data.estado == 'activa';
        allow delete: if false;
      }
    }

    // ---------- Botón de pánico ----------
    match /alertasApoyo/{id} {
      allow read: if isJefe() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if isMember()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.estado == 'abierta'
        && request.resource.data.createdAt == request.time
        && validLatLng(request.resource.data.get('ubicacion', null));
      allow update: if isJefe() && onlyChanged(['estado', 'atendidaPor', 'atendidaAt'])
        && request.resource.data.estado == 'atendida';
      allow delete: if false;
    }

    // ---------- Geolocalización ----------
    match /ubicaciones/{uid} {
      allow read: if isOwner(uid) || isJefe();
      allow create, update: if isOwner(uid) && isMember()
        && (!request.resource.data.keys().hasAny(['lat']) || validLatLng(request.resource.data));
      allow delete: if isOwner(uid);
    }

    match /presencia/{uid} {
      allow read: if isJefe();
      allow write: if isOwner(uid) && isMember();
    }

    // ---------- Simulacros ----------
    match /simulacros/{id} {
      allow read: if isMember();
      allow create, update: if isJefe();
      allow delete: if isAdmin();
    }

    // ---------- Evidencias (inmutables salvo validación) ----------
    match /evidencias/{id} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.autor.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.tipo in ['foto', 'video', 'documento', 'observacion', 'acta'];
      allow update: if isJefe() && onlyChanged(['validada', 'validadaPor']);
      allow delete: if false;
    }

    // ---------- Comunicaciones ----------
    match /canales/{canalId} {
      function canRead(c) { return c.publico == true || request.auth.uid in c.get('miembros', []); }

      allow read: if isMember() && (resource == null || canRead(resource.data));
      allow create: if isMember() && (
        isCoord()
        || (request.resource.data.publico == false
            && request.resource.data.tipo == 'directo'
            && request.resource.data.miembros.size() == 2
            && request.auth.uid in request.resource.data.miembros)
      );
      allow update: if isCoord();
      allow delete: if isAdmin();

      match /mensajes/{msgId} {
        function canal() { return get(/databases/$(database)/documents/canales/$(canalId)).data; }
        allow read: if isMember() && canRead(canal());
        allow create: if isMember() && canRead(canal())
          && request.resource.data.autor.uid == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.texto.size() <= 4000;
        allow update, delete: if false;
      }
    }

    // ---------- Auditoría (append-only) ----------
    match /auditoria/{id} {
      allow read: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /accesos/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /notificacionesLog/{id} {
      allow read: if isCoord();
      allow write: if false;
    }

    // Todo lo demás: denegado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

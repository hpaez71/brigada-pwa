{
  "name": "brigadas-emergencia-pwa",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "PWA para gestión de brigadas de emergencia empresariales (SST)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "emulators": "firebase emulators:start",
    "deploy:firebase": "firebase deploy --only firestore,storage,functions",
    "test:rules": "firebase emulators:exec --project demo-brigadas --only firestore \"node --test tests/*.test.mjs\""
  },
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@mui/icons-material": "^6.4.0",
    "@mui/material": "^6.4.0",
    "exceljs": "^4.4.0",
    "firebase": "^11.1.0",
    "idb-keyval": "^6.2.1",
    "jspdf": "^3.0.1",
    "jspdf-autotable": "^5.0.2",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.13.3",
    "workbox-core": "^7.3.0",
    "workbox-expiration": "^7.3.0",
    "workbox-precaching": "^7.3.0",
    "workbox-routing": "^7.3.0",
    "workbox-strategies": "^7.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1",
    "@firebase/rules-unit-testing": "^4.0.1"
  }
}

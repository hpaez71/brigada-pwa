{
  "name": "brigadas-functions",
  "private": true,
  "description": "Cloud Functions: notificaciones multicanal, agregados, roles y tareas programadas",
  "main": "index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "serve": "firebase emulators:start --only functions,firestore,auth",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "bootstrap-admin": "node scripts/bootstrap-admin.js",
    "check": "node -e \"require('./index.js'); console.log('OK: funciones cargadas')\""
  },
  "dependencies": {
    "firebase-admin": "^13.0.2",
    "firebase-functions": "^7.4.0",
    "nodemailer": "^6.9.16"
  }
}

# Copie como functions/.env (NO lo suba al repositorio). Firebase lo carga al desplegar.
# Para credenciales sensibles en producción considere Secret Manager:
#   firebase functions:secrets:set SMTP_PASS

FUNCTIONS_REGION=us-central1
# Máximo de instancias por función (proyectos nuevos tienen cuota baja)
FUNCTIONS_MAX_INSTANCES=3
APP_URL=https://SU-USUARIO.github.io/brigadas-pwa/
TIMEZONE=America/Bogota
ORG_NAME=Mi Empresa S.A.S.
DEFAULT_COUNTRY_CODE=57
ENFORCE_APP_CHECK=false

# Correo del primer Administrador General. Al iniciar sesión por primera vez
# (usuario creado en Firebase > Authentication) recibe el rol automáticamente,
# solo si aún no existe ningún administrador.
BOOTSTRAP_ADMIN_EMAIL=

# Correo (SMTP: Google Workspace, Microsoft 365, SendGrid, Amazon SES, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Brigadas de Emergencia <alertas@miempresa.com>"

# WhatsApp Business Cloud API (Meta). Requiere plantilla aprobada con 4 variables:
# {{1}} tipo, {{2}} nivel, {{3}} sede, {{4}} enlace
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=alerta_emergencia
WHATSAPP_LANG=es
WHATSAPP_API_VERSION=v21.0

# SMS de respaldo (Twilio). Use TWILIO_FROM o TWILIO_MESSAGING_SERVICE_SID
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=

# Niveles que disparan SMS inmediato (el resto se escala si no hay respuesta)
SMS_NIVELES_INMEDIATOS=critico
# Minutos sin respuesta antes de escalar por SMS/WhatsApp (niveles alto y crítico)
ESCALAR_MINUTOS=3
